<?xml version="1.0" encoding="UTF-8"?>
<Window shadow_type="menu_round" shadow_attached="true" layered_window="true"
		xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xmlns="http://tempuri.org/NIMDUISchema.xsd"
		>
	
	<Class name="sceneItemMenuElement" height="26" padding="20,0,20,0" margin="1,1,1,1"
		   hot_color="itemHoverColor"  fade_hot="false"/>
	
	<Class name="helperMenuText" normal_text_color="textNormalColor" font="system_12" valign="center"/>
	
	
	<MenuListBox class="menu" bkcolor="panelBkColor">
		<!--仅在主页常驻控件中显示选择其他场景-->
		<MenuItem class="sceneItemMenuElement" name="SceneItemMenu_SelectOther" width="auto">
			<Label class="helperMenuText"  text_id="STRID_SCENEITEM_MENU_SELECTOTHER"  mouse_enabled="false" keyboard_enabled="false" visible="false"/>
		</MenuItem>
		<MenuItem class="sceneItemMenuElement" name="SceneItemMenu_Load" width="auto">
			<Label class="helperMenuText"  text_id="STRID_SCENEITEM_MENU_LOAD"  mouse_enabled="false" keyboard_enabled="false"/>
		</MenuItem>
		<MenuItem class="sceneItemMenuElement" name="SceneItemMenu_Duplicate" width="auto">
			<Label class="helperMenuText"  text_id="STRID_SCENEITEM_MENU_DUPLICATE" mouse_enabled="false" keyboard_enabled="false"/>
		</MenuItem>
		<MenuItem class="sceneItemMenuElement" name="SceneItemMenu_Rename" width="auto">
			<Label class="helperMenuText"  text_id="STRID_SCENEITEM_MENU_RENAME" mouse_enabled="false" keyboard_enabled="false"/>
		</MenuItem>
		<MenuItem class="sceneItemMenuElement" name="SceneItemMenu_UploadCover" width="auto">
			<Label class="helperMenuText"  text_id="STRID_SCENEITEM_MENU_UPLOADCOVER" mouse_enabled="false" keyboard_enabled="false"/>
		</MenuItem>
		<!--仅在正在工作的场景item中显示捕获封面-->
		<MenuItem class="sceneItemMenuElement" name="SceneItemMenu_CaptureCover" width="auto">
			<Label class="helperMenuText"  text_id="STRID_SCENEITEM_MENU_CAPTURECOVER" mouse_enabled="false" keyboard_enabled="false"/>
		</MenuItem>
		<MenuItem class="sceneItemMenuElement" name="SceneItemMenu_Remove" width="auto">
			<Label class="helperMenuText"  text_id="STRID_SCENEITEM_MENU_REMOVE" mouse_enabled="false" keyboard_enabled="false"/>
		</MenuItem>
	</MenuListBox>
</Window>