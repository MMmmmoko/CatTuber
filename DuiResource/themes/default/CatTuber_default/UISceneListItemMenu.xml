<?xml version="1.0" encoding="UTF-8"?>
<Window shadow_type="menu_round" shadow_attached="true" layered_window="true"
		xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xmlns="http://tempuri.org/NIMDUISchema.xsd"
		>
	
	<Class name="sceneItemMenuElement" height="26" padding="20,0,20,0" margin="1,1,1,1"
		   hot_color="itemHoverColor"  fade_hot="false"/>
	
	<Class name="helperMenuText" normal_text_color="textNormalColor" font="system_12" valign="center"/>
	
	
	<MenuListBox class="menu" bkcolor="panelBkColor">
		<MenuItem class="sceneItemMenuElement" name="SceneListItemMenu_Settings" width="auto">
			<Label class="helperMenuText"  text_id="STRID_SCENELISTITEMMENU_SETTINGS"  mouse_enabled="false" keyboard_enabled="false"/>
		</MenuItem>
		
		<Control height="1" bkcolor="itemSeparatorColor" margin="10,0,10,0"/>
		
		<MenuItem class="sceneItemMenuElement" name="SceneListItemMenu_MoveUp" width="auto">
			<Label class="helperMenuText"  text_id="STRID_SCENELISTITEMMENU_MOVEUP"  mouse_enabled="false" keyboard_enabled="false"/>
		</MenuItem>
		<MenuItem class="sceneItemMenuElement" name="SceneListItemMenu_MoveDown" width="auto">
			<Label class="helperMenuText"  text_id="STRID_SCENELISTITEMMENU_MOVEDOWN" mouse_enabled="false" keyboard_enabled="false"/>
		</MenuItem>
		<MenuItem class="sceneItemMenuElement" name="SceneListItemMenu_MoveTop" width="auto">
			<Label class="helperMenuText"  text_id="STRID_SCENELISTITEMMENU_MOVETOP" mouse_enabled="false" keyboard_enabled="false"/>
		</MenuItem>
		<MenuItem class="sceneItemMenuElement" name="SceneListItemMenu_MoveBottom" width="auto">
			<Label class="helperMenuText"  text_id="STRID_SCENELISTITEMMENU_MOVEBOTTOM" mouse_enabled="false" keyboard_enabled="false"/>
		</MenuItem>


		<Control height="1" bkcolor="itemSeparatorColor" margin="10,0,10,0"/>
		
		<MenuItem class="sceneItemMenuElement" name="SceneListItemMenu_Remove" width="auto">
			<Label class="helperMenuText"  text_id="STRID_SCENEITEM_MENU_REMOVE" mouse_enabled="false" keyboard_enabled="false"/>
		</MenuItem>
	</MenuListBox>
</Window>