<?xml version="1.0" encoding="UTF-8"?>
<Window size="1300,900" min_size="1300,900"
        caption="0,0,0,80" use_system_caption="false" snap_layout_menu="true" sys_menu="true" sys_menu_rect="0,0,36,36"
        shadow_type="default" shadow_attached="true" shadow_snap="true" layered_window="true"
        alpha="255" size_box="4,4,4,4" icon="public/caption/logo.ico"

   		xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xmlns="http://tempuri.org/NIMDUISchema.xsd"
		>
	<VBox bkcolor="panelBkColor" visible="true">


		<!-- 工作区域，除了标题栏外的内容都放在这个大的Box区域 -->
		<HBox>
			<!-- 基础面板左侧，场景设置区域与基本控制区 有固定宽度 -->
			<VBox width="290" >
				<!-- LOGO -->
				<Button bkimage="file='CatTuberLogo_64px.png' dest='28,18,92,82'" height="100" width="auto" font="system_bold_22" text="atTuber" text_padding="70,10,20,0" normal_text_color="subjectColor"
						 cursor_type="hand" padding="20,0,20,0" halign="center"/>
				
				
				
				<!-- 主物品容器 如对于经典模型，这里就是角色桌子鼠标插槽 -->
				<VBox name="box_scenePanelContainer"/>
				
				
				
				
				<!-- 基础控制区VBOX 有固定高度-->
				<VTileBox margin="12,8,12,16"  height="180" bkcolor="panelBkColor" item_size="60,60" border_round="15,15" border_size="1" border_color="panelBorderColor"
						   padding="4,8,4,8" child_margin="4" columns="4">
					<ButtonBox name="baseControl_btn_settings" hot_color="itemHoverColor" mouse_child="false" border_round="8,8">
						<VBox >
							<Control bkimage="baseControl_settings.svg" width="auto" height="auto" halign="center"  margin="0,6,0,4"/>
							<Label text_id="STRID_BASECONTROL_SETTINGS"  normal_text_color="textNormalColor" halign="center" valign="center"/>
						</VBox>
					</ButtonBox>
					<ButtonBox name="baseControl_btn_help" hot_color="itemHoverColor" mouse_child="false" border_round="8,8">
						<VBox >
							<Control bkimage="baseControl_help.svg" width="auto" height="auto" halign="center" margin="0,6,0,4"/>
							<Label text_id="STRID_BASECONTROL_HELP"  normal_text_color="textNormalColor" halign="center" valign="center"/>
						</VBox>
					</ButtonBox>
				</VTileBox>
			</VBox>

			<VBox width="1" >
				<Control width="1" bkcolor="panelBkColor" bkcolor2="subjectColor" bkcolor2_direction="2"/>
				<Control width="1" bkcolor="subjectColor" bkcolor2="panelBkColor" bkcolor2_direction="2"/>
			</VBox>
			<!-- 工作区容器-->
			<!-- 点场景中的物品时工作区显示对应的设置项-->
			<VBox>
				<!-- 标题栏区域 -->
				<HBox name="window_caption_bar" width="stretch" height="auto">
					<Button name="btn_pageBack" width="48" height="48" margin="10,6,10,0" 
							normal_image="file='NavigationLeft32x36.svg' dest='8,6,40,42'"
							hot_image="file='NavigationLeft32x36_hot.svg' dest='8,6,40,42'"
							disabled_image="file='NavigationLeft32x36_disable.svg' dest='8,6,40,42'"
							/>
					<Button name="btn_pageFront" width="48" height="48" margin="10,6,10,0" 
							 normal_image="file='NavigationRight32x36.svg' dest='8,6,40,42'" 
							hot_image="file='NavigationRight32x36_hot.svg' dest='8,6,40,42'"
							disabled_image="file='NavigationRight32x36_disable.svg' dest='8,6,40,42'"
							/>
					<Control />
					<Button class="btn_wnd_min_11" height="32" width="40" name="minbtn" margin="0,2,0,2" />
					<Box height="stretch" width="40" margin="0,2,0,2">
						<Button class="btn_wnd_max_11" height="32" width="stretch" name="maxbtn" />
						<Button class="btn_wnd_restore_11" height="32" width="stretch" name="restorebtn" visible="false" />
					</Box>
					<Button class="btn_wnd_close_11" height="36" width="40" name="closebtn" margin="0,0,0,2" />
				</HBox>
				<Box name="box_workSpaceContainer" />
			</VBox>
		</HBox>
	</VBox>
</Window>