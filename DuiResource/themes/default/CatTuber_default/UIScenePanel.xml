<?xml version="1.0" encoding="UTF-8"?>
<Window 
   		xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xmlns="http://tempuri.org/NIMDUISchema.xsd"
		>



	<Class name="classicSlotButton" border_round="15,15" fore_hot_image="ItemForeHot_White.png"/>
	
	<Class name="itemListButton"  hot_color="itemHoverColor" margin="2,2,2,2" padding="2,2,2,2"  no_focus="true"/>


	<!-- 场景设置区域VBOX -->
	<VBox margin="5,0,5,5" >
		<Button name="scenePanel_btnSceneTitle" fade_hot="true" hot_color="itemHoverColor" height="30" width="stretch" text_padding="20,0,0,0" text_align="left,vcenter"/>

		
		
		<!--Classic CatTuber模型有三个槽位，上到下分别为角色 桌子 手持道具-->
		<VBox name="scenePanel_classicItemPanel" visible="false" height="auto">
			<Button class="classicSlotButton" margin="10,10,10,0" width="260" height="70"  name="classicSlot_Character" bkimage="ClassicSlotNoItemBG_Character.png"/>
			<HBox height="auto">
				<Button class="classicSlotButton" width="70" margin="10,8,4,10" height="70" name="classicSlot_HandheldItem" bkimage="ClassicSlotNoItemBG_HandheldItem.png"/>
				<!--<Control width="8" />-->
				<Button class="classicSlotButton" width="182" margin="4,8,10,10" height="70" name="classicSlot_Desk" bkimage="ClassicSlotNoItemBG_Desk.png"/>
			</HBox>
		</VBox>
		<VBox name="scenePanel_bongoCatPanel" visible="false" height="auto">
			<Button class="classicSlotButton" name="bongoCatSlot" bkimage="ClassicSlotNoItemBG_Character.png" margin="10,10,10,10" width="260" height="150"/>
		</VBox>
		
		<!--独立模型功能在开发完成后再开放-->
		<!--<VBox name="integralItemPanel" visible="false">
			<Button name="bongoCatSlot_Character" bkimage="ClassicSlotNoItemBG_Character.png" normal_image=""/>
		</VBox>-->
		<VBox  width="260" halign="center">
			<Label text_id="STRID_SCENEPANEL_CONTENTS" height="30" text_padding="20,0,0,0" />
			<TabBox name="sceneItemListTabBox">
				<!--窗口上限4-->
				<VirtualVListBox  bkcolor="gray" select_none_when_click_blank="true"/>
				<VirtualVListBox  bkcolor="gray" select_none_when_click_blank="true"/>
				<VirtualVListBox  bkcolor="gray" select_none_when_click_blank="true"/>
				<VirtualVListBox  bkcolor="gray" select_none_when_click_blank="true"/>
			</TabBox>
		<HBox height="auto">
			<!--场景物品的功能按钮-->
			<Button class="itemListButton" name="scenePanel_btnItemAdd" bkimage="file='list_add.svg'"  />
			<Button class="itemListButton" name="scenePanel_btnItemRemove" bkimage="file='list_delete.svg'" disabled_image="list_delete_disable.svg" enabled="false"/>
			<Button class="itemListButton" name="scenePanel_btnItemMoveDown" bkimage="file='list_moveDown.svg'" disabled_image="file='list_moveDown_disable.svg'" enabled="false"/>
			<Button class="itemListButton" name="scenePanel_btnItemMoveUp" bkimage="file='list_moveUp.svg'" disabled_image="file='list_moveUp_disable.svg'" enabled="false"/>


		</HBox>
	</VBox>
	</VBox>
</Window>