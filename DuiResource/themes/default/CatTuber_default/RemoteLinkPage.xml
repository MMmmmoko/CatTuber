<?xml version="1.0" encoding="utf-8"?>
<Window
		xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xmlns="http://tempuri.org/NIMDUISchema.xsd">



	<VBox margin="20,0,0,0">

	<HBox height="auto">
	<Label text_id="STRID_REMOTELINK" font="system_bold_22" margin="10,10,30,20" height="40" valign="center"/>
	</HBox>
		<Label text_id="STRID_REMOTELINK_DESCRIPTION"/>
		<Control bkcolor="itemSeparatorColor" height="1"/>
		
		<ButtonBox name="toggle_linkType" height="auto" mouse_child="false" border_size="1" border_color="panelBorderColor">
			<HBox height="auto" width="auto" margin="0,6,0,6">
				<Label text_id="STRID_REMOTELINK_AS_INPUT_SOURCE" normal_text_color="subjectColor_content" font="system_16" text_align="center"/>
				<Label text_id="STRID_REMOTELINK_AS_OUTPUT_TARGET" normal_text_color="textNormalColor" font="system_16" text_align="center"/>
			</HBox>
		</ButtonBox>
		
		<TabBox name="linkSettingsConatiner">
			<!--作为输出端-->
			<VBox>
				<Label text_id="STRID_REMOTELINK_AS_INPUT_SOURCE_TIP"/>

				<HBox height="auto">
					<Label text_id="STRID_REMOTELINK_AS_INPUT_SOURCE_REMOTEADDR"/>
					<RichEdit name="edit_remoteAddr" width="stretch" height="30" margin="20,3,20,0" font="system_14"
		  border_size="0,0,0,1" border_color="richedit_border_color" padding="0,6,0,0"
	  multi_line="false" auto_hscroll="true" rich_text="false"
			 want_return="true" want_ctrl_return="false" want_tab="false"
			 disabled_text_color="disabled_font_color" select_all_on_focus="true"/>
				</HBox>

				<HBox height="auto">
					<Label text_id="STRID_REMOTELINK_AS_INPUT_SOURCE_REMOTEPORT"/>
					<RichEdit name="edit_remotePort" width="stretch" height="30" margin="20,3,20,0" font="system_14"
		  border_size="0,0,0,1" border_color="richedit_border_color" padding="0,6,0,0"
	  multi_line="false" auto_hscroll="true" rich_text="false"
			 want_return="true" want_ctrl_return="false" want_tab="false"
			 disabled_text_color="disabled_font_color" select_all_on_focus="true"/>
				</HBox>
				
				<CheckBox text_id="STRID_REMOTELINK_AS_INPUT_SOURCE_DISABLERENDERING"/>

				<Button text_id="STRID_REMOTELINK_AS_INPUT_SOURCE_RUN"/>
			</VBox>
			
			
			<!--作为接收端-->
			<VBox>
				<HBox height="60">
					<VBox width="auto">
						<Label text_id="STRID_REMOTELINK_AS_OUTPUT_TARGET_LOCALIP"/>
						<Label text_id="STRID_REMOTELINK_AS_OUTPUT_TARGET_LOCALNAME"/>
					</VBox>
					<VBox width="auto">
						<Label name="text_loaclIP"/>
						<Label name="text_loaclName"/>
					</VBox>
					<VBox>
						<Button width="24" height="24" name="btn_copyIP" bkcolor="darkcolor"/>
						<Button width="24" height="24" name="btn_copyName"  bkcolor="darkcolor"/>
					</VBox>
				</HBox>
				<HBox height="auto">
					<Label text_id="STRID_REMOTELINK_AS_OUTPUT_TARGET_LOCALPORT"/>
					<RichEdit name="edit_remotePort" width="stretch" height="30" margin="20,3,20,0" font="system_14"
		  border_size="0,0,0,1" border_color="richedit_border_color" padding="0,6,0,0"
	  multi_line="false" auto_hscroll="true" rich_text="false"
			 want_return="true" want_ctrl_return="false" want_tab="false"
			 disabled_text_color="disabled_font_color" select_all_on_focus="true"/>
				</HBox>

				<CheckBox text_id="STRID_REMOTELINK_AS_OUTPUT_TARGET_DISABLEDEVICEINPUT"/>

				<Button text_id="STRID_REMOTELINK_AS_OUTPUT_TARGET_RUN"/>
			</VBox>
		</TabBox>
		
		<CheckBox text_id="STRID_REMOTELINK_RUN_WHEN_APP_START"/>
		
</VBox>
</Window>
	
	